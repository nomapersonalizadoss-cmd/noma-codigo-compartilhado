
(function() {
  var id = 'noma-beneficios-faixa';

  function inserir() {
    var newsletter = document.querySelector(
      '[data-store="newsletter"], .newsletter, #newsletter'
    );

    if (!newsletter || !newsletter.parentNode) return;

    var faixa = document.getElementById(id);

    if (!faixa) {
      faixa = document.createElement('section');
      faixa.id = id;

      faixa.innerHTML =
        '<div class="itens">' +
          '<div class="item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="17" cy="6" r="3"/><path d="M2 15l6-3 5 3 7-2 2 2-9 5-9-2zM17 1v2M21 6h2"/></svg><span>Criada por máquinas e pessoas</span></div>' +
          '<div class="item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M2 6h13v12H2zM15 10h4l3 4v4h-7z"/><circle cx="6" cy="19" r="2"/><circle cx="19" cy="19" r="2"/></svg><span>Entregamos para todo o Brasil</span></div>' +
          '<div class="item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 2l9 4v6c0 5-4 8-9 10-5-2-9-5-9-10V6z"/><path d="m7 12 3 3 7-7"/></svg><span>Compra segura</span></div>' +
          '<div class="item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/></svg><span>Várias formas de pagamento</span></div>' +
        '</div>';

      var estilo = document.createElement('style');
      estilo.id = 'noma-beneficios-estilo';
      estilo.textContent =
        '#noma-beneficios-faixa{background:#F3EBDD;color:#4D4A40;padding:12px 8px;margin:0;width:100%;font-family:Montserrat,Arial,sans-serif;box-sizing:border-box}' +
        '#noma-beneficios-faixa *{box-sizing:border-box}' +
        '#noma-beneficios-faixa .itens{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));max-width:1200px;margin:auto}' +
        '#noma-beneficios-faixa .item{text-align:center;padding:5px 8px;border-right:1px solid #C8BDAA;font-size:11px;line-height:1.35;font-weight:700;min-width:0}' +
        '#noma-beneficios-faixa .item:last-child{border-right:0}' +
        '#noma-beneficios-faixa svg{display:block;width:25px;height:25px;margin:0 auto 5px;color:#657052}' +
        '@media(max-width:768px){#noma-beneficios-faixa{padding:10px 3px}#noma-beneficios-faixa .item{padding:4px 2px;font-size:8px;line-height:1.3;overflow-wrap:anywhere}#noma-beneficios-faixa svg{width:21px;height:21px;margin-bottom:4px}}';
      document.head.appendChild(estilo);
    }

    if (faixa.parentNode !== newsletter.parentNode ||
        faixa.nextElementSibling !== newsletter) {
      newsletter.parentNode.insertBefore(faixa, newsletter);
    }
  }

  function iniciar() {
    inserir();
    var tentativas = 0;
    var timer = setInterval(function() {
      inserir();
      tentativas++;
      if (document.getElementById(id) || tentativas >= 30) {
        clearInterval(timer);
      }
    }, 1000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciar);
  } else {
    iniciar();
  }
})();
