
(function () {
  'use strict';

  var ID_FAIXA = 'noma-beneficios-faixa';
  var ID_ESTILO = 'noma-beneficios-estilo';
  var tentativas = 0;
  var intervalo = null;

  function estaNaPaginaInicial() {
    return window.location.pathname === '/';
  }

  function encontrarNewsletter() {
    var seletores = [
      '[data-store="newsletter"]',
      '.newsletter',
      '#newsletter',
      'section[data-store*="newsletter"]',
      'form[action*="newsletter"]'
    ];

    for (var i = 0; i < seletores.length; i++) {
      var elemento = document.querySelector(seletores[i]);

      if (elemento) {
        return elemento.closest('section') || elemento;
      }
    }

    var titulos = document.querySelectorAll('h1, h2, h3, h4');

    for (var j = 0; j < titulos.length; j++) {
      if (
        titulos[j].textContent.trim().toLowerCase() === 'newsletter'
      ) {
        return titulos[j].closest('section') ||
               titulos[j].parentElement.parentElement;
      }
    }

    return null;
  }

  function criarFaixa() {
    var faixa = document.createElement('section');
    faixa.id = ID_FAIXA;

    faixa.innerHTML =
      '<div class="itens">' +

        '<div class="item">' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">' +
            '<circle cx="17" cy="6" r="3"/>' +
            '<path d="M2 15l6-3 5 3 7-2 2 2-9 5-9-2zM17 1v2M21 6h2"/>' +
          '</svg>' +
          '<span>Criada por máquinas e pessoas</span>' +
        '</div>' +

        '<div class="item">' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">' +
            '<path d="M2 6h13v12H2zM15 10h4l3 4v4h-7z"/>' +
            '<circle cx="6" cy="19" r="2"/>' +
            '<circle cx="19" cy="19" r="2"/>' +
          '</svg>' +
          '<span>Entrega para todo o Brasil</span>' +
        '</div>' +

        '<div class="item">' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">' +
            '<path d="M12 2l9 4v6c0 5-4 8-9 10-5-2-9-5-9-10V6z"/>' +
            '<path d="m7 12 3 3 7-7"/>' +
          '</svg>' +
          '<span>Compra segura</span>' +
        '</div>' +

        '<div class="item">' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">' +
            '<rect x="2" y="5" width="20" height="14" rx="2"/>' +
            '<path d="M2 10h20M6 15h4"/>' +
          '</svg>' +
          '<span>Vai completa, com parte elétrica</span>' +
        '</div>' +

      '</div>';

    return faixa;
  }

  function adicionarEstilo() {
    if (document.getElementById(ID_ESTILO)) return;

    var estilo = document.createElement('style');
    estilo.id = ID_ESTILO;

    estilo.textContent =
      '#noma-beneficios-faixa{' +
        'display:block!important;' +
        'width:100%;' +
        'margin:0;' +
        'padding:12px 8px;' +
        'background:#F3EBDD;' +
        'color:#4D4A40;' +
        'font-family:Montserrat,Arial,sans-serif;' +
        'box-sizing:border-box;' +
      '}' +

      '#noma-beneficios-faixa *{' +
        'box-sizing:border-box;' +
      '}' +

      '#noma-beneficios-faixa .itens{' +
        'display:grid;' +
        'grid-template-columns:repeat(4,minmax(0,1fr));' +
        'max-width:1200px;' +
        'width:100%;' +
        'margin:0 auto;' +
      '}' +

      '#noma-beneficios-faixa .item{' +
        'display:flex;' +
        'flex-direction:column;' +
        'align-items:center;' +
        'justify-content:center;' +
        'text-align:center;' +
        'min-width:0;' +
        'padding:5px 8px;' +
        'border-right:1px solid #C8BDAA;' +
        'font-size:11px;' +
        'line-height:1.35;' +
        'font-weight:700;' +
      '}' +

      '#noma-beneficios-faixa .item:last-child{' +
        'border-right:0;' +
      '}' +

      '#noma-beneficios-faixa svg{' +
        'display:block;' +
        'width:25px;' +
        'height:25px;' +
        'flex-shrink:0;' +
        'margin:0 auto 5px;' +
        'color:#657052;' +
      '}' +

      '@media(max-width:768px){' +
        '#noma-beneficios-faixa{' +
          'padding:10px 3px;' +
        '}' +
        '#noma-beneficios-faixa .item{' +
          'padding:4px 2px;' +
          'font-size:8px;' +
          'line-height:1.3;' +
          'overflow-wrap:anywhere;' +
        '}' +
        '#noma-beneficios-faixa svg{' +
          'width:21px;' +
          'height:21px;' +
          'margin-bottom:4px;' +
        '}' +
      '}';

    document.head.appendChild(estilo);
  }

  function inserir() {
    if (!estaNaPaginaInicial()) return;

    var newsletter = encontrarNewsletter();

    if (!newsletter || !newsletter.parentNode) return;

    var faixa = document.getElementById(ID_FAIXA);

    if (!faixa) {
      faixa = criarFaixa();
    }

    if (
      faixa.parentNode !== newsletter.parentNode ||
      faixa.nextElementSibling !== newsletter
    ) {
      newsletter.parentNode.insertBefore(faixa, newsletter);
    }

    adicionarEstilo();
  }

  function iniciar() {
    inserir();

    if (intervalo) {
      clearInterval(intervalo);
    }

    tentativas = 0;

    intervalo = setInterval(function () {
      inserir();
      tentativas++;

      if (
        document.getElementById(ID_FAIXA) ||
        tentativas >= 30
      ) {
        clearInterval(intervalo);
        intervalo = null;
      }
    }, 1000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciar);
  } else {
    iniciar();
  }

})();

